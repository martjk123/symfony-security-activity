{% extends 'base.html.twig' %}

{% block title %}Home - Gym Equipments{% endblock %}

{% block body %}

<!-- Navbar -->
<nav class="bg-slate-800 text-slate-200 sticky top-0 z-50 px-6 py-3 flex justify-between items-center">
  <a href="{{ path('app_home') }}" class="text-sky-400 font-bold text-xl">💪 GymStore</a>

  <button id="menuToggle" class="md:hidden w-7 h-7 text-sky-400">
    <svg id="hamburgerIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
      <path d="M3 6h18M3 12h18M3 18h18" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <svg id="closeIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="display:none;">
      <path d="M6 6l12 12M6 18L18 6" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <ul id="navLinks" class="hidden md:flex gap-6 text-sm">
    <li><a href="{{ path('app_home') }}" class="hover:text-sky-400">Home</a></li>
    <li><a href="#" class="hover:text-sky-400">Custom</a></li>
    <li><a href="#" class="hover:text-sky-400">Contact</a></li>
    <li><a href="#" class="hover:text-sky-400">Cart</a></li>
    <li><a href="#" class="hover:text-sky-400">👤 Account</a></li>
  </ul>
</nav>

<!-- Hero Section -->
<section class="h-[60vh] bg-cover bg-center flex items-center justify-center text-white text-center"
  style="background-image: url('https://images.unsplash.com/photo-1599058917212-d750089bc08a');">
  <h1 class="text-5xl font-bold bg-black/60 px-8 py-4 rounded-xl">Build Your Home Gym Today</h1>
</section>

<!-- Categories -->
<section class="py-12 px-10">
  <h2 class="text-3xl font-semibold mb-6">Shop by Category</h2>

  <div class="flex flex-wrap gap-4 mb-10">
    <a onclick="filterProducts('all', this)" class="cursor-pointer px-5 py-2 rounded-md bg-sky-400 text-white hover:bg-sky-500 transition active">All</a>
    <a onclick="filterProducts('Dumbbells', this)" class="cursor-pointer px-5 py-2 rounded-md border border-slate-300 hover:bg-sky-400 hover:text-white transition">Dumbbells</a>
    <a onclick="filterProducts('Treadmills', this)" class="cursor-pointer px-5 py-2 rounded-md border border-slate-300 hover:bg-sky-400 hover:text-white transition">Treadmills</a>
  </div>

  <div id="productContainer"></div>
</section>

<!-- Equipment Recommendation -->
<section class="bg-slate-100 py-10 px-10 rounded-lg text-center">
  <h2 class="text-2xl font-semibold mb-3">Find the Best Equipment for Your Fitness Goals</h2>
  <p class="text-slate-600 mb-5">Select your goal and we’ll recommend the right gear for you.</p>

  <form id="goalForm" class="flex flex-wrap justify-center items-center gap-3">
    <label for="goal" class="text-slate-700">Choose your goal:</label>
    <select id="goal" name="goal" class="border border-slate-300 rounded-md px-3 py-2 text-sm">
      <option value="">-- Select a goal --</option>
      <option value="muscle">Build Muscle</option>
      <option value="weightloss">Lose Weight</option>
      <option value="endurance">Improve Endurance</option>
      <option value="strength">Increase Strength</option>
      <option value="flexibility">Improve Flexibility</option>
    </select>
    <button type="submit" class="bg-sky-400 text-white px-4 py-2 rounded-md hover:bg-sky-500 transition">Get Recommendations</button>
  </form>

  <div id="recommendationResults" class="mt-8"></div>
</section>
{% endblock %}

{% block javascripts %}
<script>
// Paste all your JS code here (menu toggle, product render, filter)
</script>
{% endblock %}
