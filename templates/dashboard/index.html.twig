{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
  <h1>Welcome to the Dashboard</h1>

  {% if role == 'admin' %}
      <p style="color: green;">You are logged in as <strong>Admin</strong>. You have full access.</p>
  {% else %}
      <p style="color: blue;">You are logged in as <strong>Regular User</strong>. Limited access granted.</p>
  {% endif %}
{% endblock %}
