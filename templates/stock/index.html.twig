{% extends 'base.html.twig' %}

{% block title %}Stock List{% endblock %}

{% block body %}
<h1>Stock List</h1>

<a href="{{ path('stock_new') }}" class="btn btn-primary mb-4">Add New Stock</a>

<table class="table-auto w-full border">
    <thead>
        <tr>
            <th class="border px-2 py-1">Name</th>
            <th class="border px-2 py-1">Category</th>
            <th class="border px-2 py-1">Price</th>
            <th class="border px-2 py-1">Color</th>
            <th class="border px-2 py-1">Quantity</th>
            <th class="border px-2 py-1">Maintenance Interval</th>
            <th class="border px-2 py-1">Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for stock in stocks %}
        <tr>
            <td class="border px-2 py-1">{{ stock.name }}</td>
            <td class="border px-2 py-1">{{ stock.category }}</td>
            <td class="border px-2 py-1">{{ stock.price }}</td>
            <td class="border px-2 py-1">{{ stock.color }}</td>
            <td class="border px-2 py-1">{{ stock.quantity }}</td>
            <td class="border px-2 py-1">{{ stock.maintenanceInterval }}</td>
            <td class="border px-2 py-1">
                <a href="{{ path('stock_edit', {'id': stock.id}) }}" class="btn btn-yellow">Edit</a>
                <form method="post" action="{{ path('stock_delete', {'id': stock.id}) }}" style="display:inline-block" onsubmit="return confirm('Are you sure?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.id) }}">
                    <button class="btn btn-red" type="submit">Delete</button>
                </form>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
